# Local Docker Compose configuration
# Copy this file to .env and fill in real local/development values.

# Service Bus connection string used by the API and Function App.
# For local API startup validation, a dummy value is enough.
# For end-to-end message processing, use a real Azure Service Bus connection string.
SERVICEBUS_CONNECTION=Endpoint=sb://dummy.servicebus.windows.net/;SharedAccessKeyName=dummy;SharedAccessKey=dummy

# Azurite local storage emulator connection string.
AZURE_WEBJOBS_STORAGE=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNoA6uxJJ2RduH9GO3mLTYHnJ0zVQ==;BlobEndpoint=http://azurite:10000/devstoreaccount1;QueueEndpoint=http://azurite:10001/devstoreaccount1;TableEndpoint=http://azurite:10002/devstoreaccount1;
